{
  "openapi": "3.1.0",
  "info": {
    "title": "Students app",
    "version": "1.0.0",
    "description": "Students API documentation"
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "tags": [
    {
      "name": "Students",
      "description": "Operations about students."
    },
    {
      "name": "Auth",
      "description": "Authentication operations."
    }
  ],
  "paths": {
    "/students/{studentId}": {
      "get": {
        "tags": [
          "Students"
        ],
        "summary": "Get student by ID",
        "operationId": "getStudentById",
        "description": "Find one student using the student's ID.",
        "parameters": [
          {
            "in": "path",
            "name": "studentId",
            "required": true,
            "schema": {
              "type": "string",
              "example": "65ca67e7ae7f10c88b598375"
            }
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Student found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "message",
                    "data"
                  ],
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 200
                    },
                    "message": {
                      "type": "string",
                      "example": "Successfully found a student!"
                    },
                    "data": {
                      "$ref": "#/components/schemas/student"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "description": "User does not have permission to access this student."
          },
          "404": {
            "description": "Student not found."
          }
        }
      },
      "put": {
        "tags": [
          "Students"
        ],
        "summary": "Create or update a student",
        "operationId": "upsertStudent",
        "description": "Creates a student if the given ID does not exist. Updates the student if it does. Requires a teacher account.\n",
        "parameters": [
          {
            "in": "path",
            "name": "studentId",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The ID of the student to create or update."
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "age",
                  "gender",
                  "avgMark",
                  "parentId"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "John Doe"
                  },
                  "age": {
                    "type": "integer",
                    "example": 12
                  },
                  "gender": {
                    "type": "string",
                    "enum": [
                      "male",
                      "female",
                      "other"
                    ],
                    "example": "male"
                  },
                  "avgMark": {
                    "type": "number",
                    "example": 9.7
                  },
                  "onDuty": {
                    "type": "boolean",
                    "example": false
                  },
                  "parentId": {
                    "type": "string",
                    "example": "65e4decdd286b30065d54af9"
                  },
                  "photo": {
                    "type": "string",
                    "format": "binary",
                    "description": "Optional student photo."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Existing student updated.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 200
                    },
                    "message": {
                      "type": "string",
                      "example": "Successfully upserted a student!"
                    },
                    "data": {
                      "$ref": "#/components/schemas/student"
                    }
                  }
                }
              }
            }
          },
          "201": {
            "description": "Student created because the given ID did not exist.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 201
                    },
                    "message": {
                      "type": "string",
                      "example": "Successfully upserted a student!"
                    },
                    "data": {
                      "$ref": "#/components/schemas/student"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "description": "Only teachers can create or update students with this operation."
          }
        }
      },
      "patch": {
        "tags": [
          "Students"
        ],
        "summary": "Partially update a student",
        "operationId": "patchStudent",
        "description": "Updates only the fields provided in the request. Teachers can update any student. Parents can update only their own student.\n",
        "parameters": [
          {
            "in": "path",
            "name": "studentId",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The ID of the student to update."
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 30,
                    "example": "John Doe"
                  },
                  "age": {
                    "type": "integer",
                    "minimum": 6,
                    "maximum": 16,
                    "example": 12
                  },
                  "gender": {
                    "type": "string",
                    "enum": [
                      "male",
                      "female",
                      "other"
                    ],
                    "example": "male"
                  },
                  "avgMark": {
                    "type": "number",
                    "minimum": 2,
                    "maximum": 12,
                    "example": 9.7
                  },
                  "onDuty": {
                    "type": "boolean",
                    "example": false
                  },
                  "photo": {
                    "type": "string",
                    "format": "binary",
                    "description": "Optional student photo."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Student updated.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 200
                    },
                    "message": {
                      "type": "string",
                      "example": "Successfully patched a student!"
                    },
                    "data": {
                      "$ref": "#/components/schemas/student"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid student ID or invalid request data."
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "description": "The user is not allowed to update this student."
          },
          "404": {
            "description": "Student not found."
          }
        }
      },
      "delete": {
        "tags": [
          "Students"
        ],
        "summary": "Delete a student",
        "operationId": "deleteStudent",
        "description": "Requires a teacher account.",
        "parameters": [
          {
            "in": "path",
            "name": "studentId",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The ID of the student to delete."
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Student deleted successfully. No response body is returned."
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "description": "Only teachers can delete students."
          },
          "404": {
            "description": "Student not found."
          }
        }
      }
    },
    "/students": {
      "get": {
        "tags": [
          "Students"
        ],
        "summary": "Get list of students",
        "operationId": "getStudents",
        "description": "Retrieve the students list. Requires a teacher account.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer"
            },
            "example": 1,
            "description": "Page number to return."
          },
          {
            "in": "query",
            "name": "perPage",
            "schema": {
              "type": "integer"
            },
            "example": 10,
            "description": "Number of students per page."
          },
          {
            "in": "query",
            "name": "sortBy",
            "schema": {
              "type": "string"
            },
            "example": "age",
            "description": "Student field to sort by. Defaults to _id."
          },
          {
            "in": "query",
            "name": "sortOrder",
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            },
            "example": "asc",
            "description": "Sort direction."
          },
          {
            "in": "query",
            "name": "minAvgMark",
            "schema": {
              "type": "number"
            },
            "example": 4,
            "description": "Minimum average mark."
          },
          {
            "in": "query",
            "name": "maxAvgMark",
            "schema": {
              "type": "number"
            },
            "example": 10,
            "description": "Maximum average mark."
          },
          {
            "in": "query",
            "name": "minAge",
            "schema": {
              "type": "number"
            },
            "example": 10,
            "description": "Minimum age."
          },
          {
            "in": "query",
            "name": "maxAge",
            "schema": {
              "type": "number"
            },
            "example": 16,
            "description": "Maximum age."
          },
          {
            "in": "query",
            "name": "gender",
            "schema": {
              "type": "string",
              "enum": [
                "male",
                "female",
                "other"
              ]
            },
            "example": "male",
            "description": "Filter by gender."
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully found students!",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "message",
                    "data"
                  ],
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 200
                    },
                    "message": {
                      "type": "string",
                      "example": "Successfully found students!"
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "data",
                        "page",
                        "perPage",
                        "totalItems",
                        "totalPages",
                        "hasNextPage",
                        "hasPreviousPage"
                      ],
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/student"
                          }
                        },
                        "page": {
                          "type": "number",
                          "example": 2
                        },
                        "perPage": {
                          "type": "number",
                          "example": 4
                        },
                        "totalItems": {
                          "type": "number",
                          "example": 4
                        },
                        "totalPages": {
                          "type": "number",
                          "example": 4
                        },
                        "hasNextPage": {
                          "type": "boolean",
                          "example": false
                        },
                        "hasPreviousPage": {
                          "type": "boolean",
                          "example": true
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "description": "Only teachers can access the students list."
          }
        }
      },
      "post": {
        "tags": [
          "Students"
        ],
        "summary": "Create student",
        "operationId": "createStudent",
        "description": "Create a student. Requires a teacher account.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "age",
                  "gender",
                  "avgMark",
                  "parentId"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "John Doe"
                  },
                  "age": {
                    "type": "number",
                    "example": 12
                  },
                  "gender": {
                    "type": "string",
                    "enum": [
                      "male",
                      "female",
                      "other"
                    ]
                  },
                  "avgMark": {
                    "type": "number",
                    "example": 9.7
                  },
                  "onDuty": {
                    "type": "boolean",
                    "example": false
                  },
                  "parentId": {
                    "type": "string",
                    "example": "65e4decdd286b30065d54af9"
                  },
                  "photo": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Student created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "message",
                    "data"
                  ],
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 201
                    },
                    "message": {
                      "type": "string",
                      "example": "Successfully created a student!"
                    },
                    "data": {
                      "$ref": "#/components/schemas/student"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "description": "Only teachers can create students."
          }
        }
      }
    },
    "/auth/get-oauth-url": {
      "get": {
        "security": [],
        "tags": [
          "Auth"
        ],
        "summary": "Get Google OAuth URL",
        "operationId": "getGoogleOAuthUrl",
        "description": "Returns the URL used to start Google sign-in.",
        "responses": {
          "200": {
            "description": "Google OAuth URL returned successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 200
                    },
                    "message": {
                      "type": "string",
                      "example": "Successfully got Google OAuth URL!"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "url": {
                          "type": "string",
                          "format": "uri",
                          "example": "https://accounts.google.com/o/oauth2/v2/auth"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/confirm-oauth": {
      "post": {
        "security": [],
        "tags": [
          "Auth"
        ],
        "summary": "Complete Google sign-in",
        "operationId": "loginWithGoogle",
        "description": "Exchanges the short-lived authorization code from Google for an application access token. Also sets the refreshToken and sessionId cookies.\n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "code"
                ],
                "properties": {
                  "code": {
                    "type": "string",
                    "example": "google-authorization-code"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Google sign-in completed successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 200
                    },
                    "message": {
                      "type": "string",
                      "example": "Successfully logged in via Google OAuth!"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "accessToken": {
                          "type": "string",
                          "example": "your-access-token"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "The required code field is missing or invalid."
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "security": [],
        "tags": [
          "Auth"
        ],
        "summary": "Log in with email and password",
        "operationId": "loginUser",
        "description": "Logs in a user, sets the refreshToken and sessionId cookies, and returns an access token.\n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "user@example.com"
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "example": "StrongPassword123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful. Session cookies are also set.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 200
                    },
                    "message": {
                      "type": "string",
                      "example": "Successfully logged in a user!"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "accessToken": {
                          "type": "string",
                          "example": "your-access-token"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "The request body is invalid."
          },
          "401": {
            "description": "Email or password is incorrect."
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "security": [],
        "tags": [
          "Auth"
        ],
        "summary": "Register a user",
        "operationId": "registerUser",
        "description": "Creates a user account. The role is assigned by the server and is not provided in the request.\n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "email",
                  "password"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 30,
                    "example": "Jane Doe"
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "jane@example.com"
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "example": "StrongPassword123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User registered successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 201
                    },
                    "message": {
                      "type": "string",
                      "example": "Successfully registered a user!"
                    },
                    "data": {
                      "type": "object",
                      "description": "Registered user data without the password."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "The request body is invalid."
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "security": [],
        "tags": [
          "Auth"
        ],
        "summary": "Log out",
        "operationId": "logoutUser",
        "description": "Uses the sessionId cookie when present, clears the sessionId and refreshToken cookies, and returns no response body.\n",
        "parameters": [
          {
            "in": "cookie",
            "name": "sessionId",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Session identifier cookie."
          }
        ],
        "responses": {
          "204": {
            "description": "Logged out successfully. No response body is returned."
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "security": [],
        "tags": [
          "Auth"
        ],
        "summary": "Refresh user session",
        "operationId": "refreshUserSession",
        "description": "Uses the sessionId and refreshToken cookies to create a refreshed session. Returns a new access token and updates the session cookies.\n",
        "parameters": [
          {
            "in": "cookie",
            "name": "sessionId",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Current session identifier cookie."
          },
          {
            "in": "cookie",
            "name": "refreshToken",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Current refresh token cookie."
          }
        ],
        "responses": {
          "200": {
            "description": "Session refreshed successfully. New session cookies are also set.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 200
                    },
                    "message": {
                      "type": "string",
                      "example": "Successfully refreshed a session!"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "accessToken": {
                          "type": "string",
                          "example": "your-access-token"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "The session or refresh token is invalid or expired."
          }
        }
      }
    },
    "/auth/request-reset-email": {
      "post": {
        "security": [],
        "tags": [
          "Auth"
        ],
        "summary": "Request a password reset email",
        "operationId": "requestResetEmail",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "user@example.com"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password reset email request processed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 200
                    },
                    "message": {
                      "type": "string",
                      "example": "Reset password email was successfully sent!"
                    },
                    "data": {
                      "type": "object",
                      "example": {}
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "The email is missing or invalid."
          }
        }
      }
    },
    "/auth/reset-password": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Reset a user's password",
        "operationId": "resetPassword",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "password",
                  "token"
                ],
                "properties": {
                  "password": {
                    "type": "string",
                    "format": "password",
                    "example": "NewPassword123"
                  },
                  "token": {
                    "type": "string",
                    "example": "password-reset-token"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password reset successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 200
                    },
                    "message": {
                      "type": "string",
